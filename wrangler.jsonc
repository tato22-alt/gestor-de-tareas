{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asistente-papa",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asistente",
      // Se completa en T14 con el id que devuelve `wrangler d1 create asistente`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // Secretos (con `wrangler secret put`): TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, GROQ_API_KEY.
}
